# For reference only; Spring Boot does not automatically import .env files.
GATEWAY_PORT=8080
AUTH_SERVICE_URL=http://127.0.0.1:8081

# Shared secret with the Next.js BFF (same value as GATEWAY_BFF_KEY on Vercel).
# At least 32 characters; leave empty to disable trusted client IP forwarding.
# Generate with: openssl rand -base64 48
GATEWAY_BFF_KEY=

# Per-client rate limits (requests per minute). Defaults shown.
AUTH_LOGIN_RATE_CAPACITY=10
AUTH_LOGIN_REFILL_TOKENS=10
AUTH_REGISTER_RATE_CAPACITY=5
AUTH_REGISTER_REFILL_TOKENS=5
AUTH_REFRESH_RATE_CAPACITY=30
AUTH_REFRESH_REFILL_TOKENS=30
GATEWAY_RATE_LIMIT_MAX_BUCKETS=50000
